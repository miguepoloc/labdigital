# Copia como .env.local para desarrollo.
# 1 = usa los mocks de MSW (por defecto en `npm run dev`); 0 = usa la API real vía proxy.
VITE_API_MOCK=1
# Destino del proxy de desarrollo para /labdigital/api cuando VITE_API_MOCK=0.
LD_API_PROXY=http://127.0.0.1:8088
# Origen del OpenAPI para `npm run gen:api`.
OPENAPI_URL=http://127.0.0.1:8088/labdigital/api/openapi.json
# Sólo desarrollo: módulo FPGA del iframe. Sin JG FPGA local, usa el stub con window.JGFPGA falso.
# VITE_FPGA_URL=/labdigital/dev-fpga-stub.html
