{
  "name": "labdigital-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPA y landing de LabDigital GIDEAM (Vue 3 + TypeScript + Vite)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.18",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.6.0",
    "jsdom": "^26.1.0",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-ssg": "^28.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
