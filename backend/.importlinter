; Contratos import-linter — ARCHITECTURE.md §16. Run: lint-imports
; Cada subcontexto nuevo recibe TODOS los contratos (no un subconjunto).
;
; Contextos: identity.users, identity.sessions (con identity.commons compartido y
; orquestadores en identity.services), projects.projects, teaching.{courses,labs,submissions}
; (con teaching.commons y orquestadores en teaching.services) y files.blobs. Lo que cruza
; productos pasa por puertos cuyos adaptadores viven en backend.orchestrators. `backend.entrypoints` es la raíz
; de composición del proceso (app FastAPI única + worker).

[importlinter]
root_package = backend
include_external_packages = True

; ---------------------------------------------------------------------------
; Contrato 1 — Pureza del dominio.
; ---------------------------------------------------------------------------
[importlinter:contract:domain-purity]
name = Domain purity
type = forbidden
source_modules =
    backend.commons.domain
    backend.identity.commons
    backend.identity.users.domain
    backend.identity.sessions.domain
    backend.projects.projects.domain
    backend.teaching.commons
    backend.teaching.courses.domain
    backend.teaching.labs.domain
    backend.teaching.submissions.domain
    backend.files.blobs.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    httpx
    smtplib
    jwt

; ---------------------------------------------------------------------------
; Contrato 2 — Capas dentro de cada subcontexto.
; ---------------------------------------------------------------------------
[importlinter:contract:users-layering]
name = identity.users layering
type = layers
layers =
    backend.identity.users.services
    backend.identity.users.adapters
    backend.identity.users.domain

[importlinter:contract:sessions-layering]
name = identity.sessions layering
type = layers
layers =
    backend.identity.sessions.services
    backend.identity.sessions.adapters
    backend.identity.sessions.domain

[importlinter:contract:projects-layering]
name = projects.projects layering
type = layers
layers =
    backend.projects.projects.services
    backend.projects.projects.adapters
    backend.projects.projects.domain

[importlinter:contract:courses-layering]
name = teaching.courses layering
type = layers
layers =
    backend.teaching.courses.services
    backend.teaching.courses.adapters
    backend.teaching.courses.domain

[importlinter:contract:labs-layering]
name = teaching.labs layering
type = layers
layers =
    backend.teaching.labs.services
    backend.teaching.labs.adapters
    backend.teaching.labs.domain

[importlinter:contract:submissions-layering]
name = teaching.submissions layering
type = layers
layers =
    backend.teaching.submissions.services
    backend.teaching.submissions.adapters
    backend.teaching.submissions.domain

[importlinter:contract:blobs-layering]
name = files.blobs layering
type = layers
layers =
    backend.files.blobs.services
    backend.files.blobs.adapters
    backend.files.blobs.domain

; ---------------------------------------------------------------------------
; Contrato 3 — Independencia de contextos. users <-> sessions sólo vía identity.commons o
; los orquestadores de identity.services. projects no conoce identity (y viceversa): el
; dueño de un proyecto llega como el `sub` del access, nunca importando identity.
; ---------------------------------------------------------------------------
[importlinter:contract:users-sessions-independence]
name = identity users/sessions independence
type = independence
modules =
    backend.identity.users
    backend.identity.sessions

[importlinter:contract:products-independence]
name = products independence (identity, projects, teaching, files)
type = independence
modules =
    backend.identity
    backend.projects
    backend.teaching
    backend.files

; Subcontextos de teaching: sólo se hablan vía teaching.commons o los orquestadores de
; teaching.services.
[importlinter:contract:teaching-subcontexts-independence]
name = teaching subcontexts independence
type = independence
modules =
    backend.teaching.courses
    backend.teaching.labs
    backend.teaching.submissions

; ---------------------------------------------------------------------------
; Contrato 4 — commons (global y de producto) no importa productos.
; ---------------------------------------------------------------------------
[importlinter:contract:commons-independence]
name = commons independence
type = forbidden
source_modules =
    backend.commons
forbidden_modules =
    backend.identity
    backend.projects
    backend.teaching
    backend.files
    backend.orchestrators
    backend.entrypoints

[importlinter:contract:identity-commons-independence]
name = identity.commons independence
type = forbidden
source_modules =
    backend.identity.commons
forbidden_modules =
    backend.identity.users
    backend.identity.sessions
    backend.identity.services
    backend.identity.entrypoints

[importlinter:contract:teaching-commons-independence]
name = teaching.commons independence
type = forbidden
source_modules =
    backend.teaching.commons
forbidden_modules =
    backend.teaching.courses
    backend.teaching.labs
    backend.teaching.submissions
    backend.teaching.services
    backend.teaching.entrypoints

; ---------------------------------------------------------------------------
; Contrato 5 — Entrypoints delgados: servicios/orquestadores y commons, nunca agregados ni
; persistencia. (Importes DIRECTOS: allow_indirect_imports, ver §16.1.)
; ---------------------------------------------------------------------------
[importlinter:contract:entrypoints-thinness]
name = entrypoint thinness
type = forbidden
allow_indirect_imports = true
source_modules =
    backend.identity.entrypoints
    backend.projects.entrypoints
    backend.teaching.entrypoints
    backend.files.entrypoints
    backend.entrypoints
forbidden_modules =
    backend.identity.users.domain.model.aggregate
    backend.identity.users.adapters
    backend.identity.sessions.domain.model.aggregate
    backend.identity.sessions.adapters
    backend.projects.projects.domain.model.aggregate
    backend.projects.projects.adapters
    backend.teaching.courses.domain.model.aggregate
    backend.teaching.courses.adapters
    backend.teaching.labs.domain.model.aggregate
    backend.teaching.labs.adapters
    backend.teaching.submissions.domain.model.aggregate
    backend.teaching.submissions.adapters
    backend.files.blobs.domain.model.aggregate
    backend.files.blobs.adapters.orm
    backend.files.blobs.adapters.repository

; ---------------------------------------------------------------------------
; Contrato 6 — Orquestadores delgados: servicios + value_objects/exceptions sólo.
; ---------------------------------------------------------------------------
[importlinter:contract:orchestrator-thinness]
name = orchestrator thinness
type = forbidden
allow_indirect_imports = true
source_modules =
    backend.identity.services
    backend.teaching.services
    backend.orchestrators
forbidden_modules =
    backend.identity.users.domain.model.aggregate
    backend.identity.users.domain.model.events
    backend.identity.users.domain.model.rules
    backend.identity.users.adapters
    backend.identity.sessions.domain.model.aggregate
    backend.identity.sessions.domain.model.events
    backend.identity.sessions.adapters
    backend.projects.projects.domain.model.aggregate
    backend.projects.projects.adapters
    backend.teaching.courses.domain.model.aggregate
    backend.teaching.courses.domain.model.events
    backend.teaching.courses.adapters
    backend.teaching.labs.domain.model.aggregate
    backend.teaching.labs.domain.model.events
    backend.teaching.labs.adapters
    backend.teaching.submissions.domain.model.aggregate
    backend.teaching.submissions.domain.model.events
    backend.teaching.submissions.adapters
    backend.files.blobs.domain.model.aggregate
    backend.files.blobs.adapters
