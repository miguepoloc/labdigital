# Copy to .env and fill in real values for local development.
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_USER=backend
DB_PASSWORD=backend
DB_NAME=backend

# RS256 key pair — identity/users signs, every product verifies (ARCHITECTURE.md §9.3).
# Generate a local dev pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Service-to-service auth for entrypoints/web/internal.py (ARCHITECTURE.md §9.2).
INTERNAL_API_KEY=dev-only-change-me

# Only needed if you exercise the real HTTP adapters (pricing_adapter, user_profile_adapter)
# rather than injecting a fake port in tests.
PRICING_SERVICE_BASE_URL=http://localhost:9000
IDENTITY_INTERNAL_API_BASE_URL=http://localhost:8001

# Outbox relay — SNS topic ARNs (ARCHITECTURE.md §11.2), one per product.
SNS_TOPIC_ARN_IDENTITY=arn:aws:sns:us-east-1:000000000000:identity-events
SNS_TOPIC_ARN_COMMERCE=arn:aws:sns:us-east-1:000000000000:commerce-events
