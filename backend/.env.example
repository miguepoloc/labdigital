# Copiar a .env y rellenar. Todas las variables las lee commons/adapters/settings.py.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://labdigital:labdigital@127.0.0.1:18432/labdigital

# Par RS256 (contrato §2). Generar:
#   openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Se admite el PEM en una línea con \n literales.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=ld-1
# Rotación: clave pública anterior (sigue en el JWKS hasta que caduquen sus access).
JWT_PREVIOUS_PUBLIC_KEY_PEM=
JWT_PREVIOUS_KID=

# Correo (Brevo SMTP en producción)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM="LabDigital GIDEAM <no-responder@mcda.tools>"

PUBLIC_BASE_URL=https://gideam.unimagdalena.edu.co/labdigital
ADMIN_EMAILS=
# false sólo para pruebas locales por http://
COOKIE_SECURE=true
DATA_POLICY_VERSION=acuerdo-17-2018
WORKER_POLL_SECONDS=5
# Archivos subidos (informes, .bit, adjuntos); en Docker, el volumen labdigital-blobs.
BLOB_DIR=/data/blobs
